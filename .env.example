# Base URL used by the newsletter confirmation link.
# Local dev: http://localhost:4321
# Production: https://www.goldsimulations.com
SITE_URL=

# Supabase project (shared with econrunes and future games for cross-subdomain SSO).
# The newsletter writes the subscribers table using the service-role key;
# all access is server-only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Resend.
# - API key must be Full access: the confirm route writes contacts, and Resend's
#   Sending access level cannot touch contacts or segments.
# - Segment: the "Gold Simulations News" segment that confirmed subscribers join.
#   Resend has migrated from audiences to segments, so there is no audience ID.
# - Sending domains are split by reputation profile, and each must be verified
#   in Resend before it will send:
#     mail.goldsimulations.com     transactional — confirmations, and later
#                                  password resets, receipts, class invites.
#                                  Must always arrive; no unsubscribes.
#     updates.goldsimulations.com  marketing — the newsletter. Broadcasts set
#                                  their own From in the Resend dashboard, so
#                                  there is no env var for it yet.
#   Keeping them apart means a newsletter that collects spam complaints cannot
#   degrade delivery of account email. Replies to both go to the contact@
#   Workspace group (set in src/lib/sendConfirmationEmail.ts).
RESEND_API_KEY=
RESEND_SEGMENT_ID_GOLDSIMULATIONS_NEWS=
SEND_TRANSACTIONAL_FROM="Gold Simulations <hello@mail.goldsimulations.com>"
