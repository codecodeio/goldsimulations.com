# Base URL used by the newsletter confirmation link.
# Local dev: http://localhost:4321
# Production: https://www.goldsimulations.com
SITE_URL=

# Supabase project (shared with econrunes and future games for cross-subdomain SSO).
# The newsletter writes the subscribers table using the service-role key;
# all access is server-only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Resend.
# - API key with `Sending access` + `Audience access`.
# - Audience: the single "Gold Simulations" audience that fans out into topic segments.
# - Segment: the "Gold Simulations News" topic that the apex newsletter writes to.
# - From: the verified sending identity (recommended subdomain: news.goldsimulations.com).
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
RESEND_SEGMENT_ID_GOLDSIMULATIONS_NEWS=
SEND_EMAIL_FROM="Gold Simulations <news@updates.goldsimulations.com>"
