---
import AccentBlur from "@/components/accent-blur/AccentBlur.astro";
import PricingFourCards from "@/components/pricing/PricingFourCards.astro";
import { getLocaleFromUrl } from "@/js/localeUtils";
import { getTranslatedData } from "@/js/translationUtils";
import BaseLayout from "@/layouts/BaseLayout.astro";

const currLocale = getLocaleFromUrl(Astro.url);
const siteData = getTranslatedData("siteData", currLocale);
---

<BaseLayout title={siteData.title} description={siteData.description} navStyle="default">
  <div class="relative overflow-clip">
    <div class="relative z-10">
      <PricingFourCards />
    </div>
    <AccentBlur color="blue" />
  </div>
</BaseLayout>