---
export const prerender = false;

import {
  RESEND_API_KEY,
  RESEND_AUDIENCE_ID,
  RESEND_SEGMENT_ID_GOLDSIMULATIONS_NEWS,
} from "astro:env/server";
import { Resend } from "resend";

import Button from "@/components/button/Button.astro";
import { Alert, AlertDescription, AlertTitle } from "@/components/starwind/alert";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { supabase } from "@/lib/supabase";

const token = Astro.url.searchParams.get("token");
const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

type Status = "success" | "invalid";
let status: Status = "invalid";

if (token && UUID_RE.test(token)) {
  const { data: subscriber, error: lookupError } = await supabase
    .from("newsletter_subscribers")
    .select("email, confirmed_at")
    .eq("confirmation_token", token)
    .maybeSingle();

  if (lookupError) {
    console.error("supabase confirm lookup error:", lookupError);
  }

  if (subscriber && !subscriber.confirmed_at) {
    const { error: updateError } = await supabase
      .from("newsletter_subscribers")
      .update({
        confirmed_at: new Date().toISOString(),
        updated_at: new Date().toISOString(),
      })
      .eq("confirmation_token", token);

    if (updateError) {
      console.error("supabase confirm update error:", updateError);
    } else {
      const resend = new Resend(RESEND_API_KEY);

      const { error: contactError } = await resend.contacts.create({
        email: subscriber.email,
        audienceId: RESEND_AUDIENCE_ID,
        unsubscribed: false,
      });

      // "already exists" is fine — idempotent add.
      if (contactError && !/already exists/i.test(contactError.message ?? "")) {
        console.error("resend.contacts.create error:", contactError);
      }

      const { error: segmentError } = await resend.contacts.segments.add({
        email: subscriber.email,
        segmentId: RESEND_SEGMENT_ID_GOLDSIMULATIONS_NEWS,
      });

      if (segmentError && !/already/i.test(segmentError.message ?? "")) {
        console.error("resend.contacts.segments.add error:", segmentError);
      }

      status = "success";
    }
  } else if (subscriber?.confirmed_at) {
    // Already confirmed: treat as success so a repeat click doesn't scare the user.
    status = "success";
  }
}
---

<BaseLayout
  title="Confirm subscription"
  description="Confirm your subscription to the Gold Simulations newsletter."
  noindex={true}
>
  <section class="site-container py-24">
    <div class="mx-auto max-w-lg space-y-8">
      {
        status === "success" && (
          <Alert variant="success">
            <AlertTitle>You're subscribed</AlertTitle>
            <AlertDescription>
              Thanks for confirming. We'll be in touch with the latest from Gold Simulations.
            </AlertDescription>
          </Alert>
        )
      }

      {
        status === "invalid" && (
          <Alert variant="warning">
            <AlertTitle>This link isn't valid</AlertTitle>
            <AlertDescription>
              It may have expired or already been used. Try subscribing again to get a fresh confirmation email.
            </AlertDescription>
          </Alert>
        )
      }

      <div class="text-center">
        <Button href="/" variant="outline">Return to homepage</Button>
      </div>
    </div>
  </section>
</BaseLayout>
