---
import { getLocaleFromUrl } from "@/js/localeUtils";
import { getTranslatedData } from "@/js/translationUtils";
import BaseLayout from "@/layouts/BaseLayout.astro";
import AboutSideImage from "@/components/about/AboutSideImage.astro";
import HeroBasicWhatsLearned from "@/components/hero/HeroBasicWhatsLearned.astro";
import PedagogyHighlights from "@/components/feature/PedagogyHighlights.astro";
import HowStudentsLearn from "@/components/feature/HowStudentsLearn.astro";
import RoadmapCallout from "@/components/feature/RoadmapCallout.astro";
import ChallengeSection from "@/components/feature/ChallengeSection.astro";
import SolutionSection from "@/components/feature/SolutionSection.astro";

const currLocale = getLocaleFromUrl(Astro.url);
const siteData = getTranslatedData("siteData", currLocale);
---

<BaseLayout title={siteData.title} description={siteData.description} navStyle="default">
  <AboutSideImage />
  <PedagogyHighlights />
  <HowStudentsLearn />
  <ChallengeSection />
  <SolutionSection />
  <HeroBasicWhatsLearned />
  <RoadmapCallout />
</BaseLayout>
