---
import AccentBlur from "@/components/accent-blur/AccentBlur.astro";
import Button from "@/components/starwind/button";
import { getLocaleFromUrl } from "@/js/localeUtils";

import BaseLayout from "@/layouts/BaseLayout.astro";

const currLocale = getLocaleFromUrl(Astro.url);
---

<BaseLayout title="404" description="Error 404 page not found." noindex={true}>
  <section
    class="relative flex min-h-[90vh] flex-col items-center justify-center overflow-clip py-24 text-center"
  >
    <div class="site-container">
      <div class="relative z-10 flex flex-col items-center">
        <h1 class="mb-4 text-6xl font-semibold">404</h1>
        <p class="mb-6 text-xl">Sorry, the page you are looking for could not be found.</p>
        <Button href={"/"} variant="primary"> Return Home </Button>
      </div>
    </div>
    <AccentBlur color="blue" />
  </section>
</BaseLayout>