---
import { Icon } from "astro-icon/components";

import ShineText from "@/components/shine-text/ShineText.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { socialLinks } from "@/config/en/socialLinks";

// Deliberately not a contact form. The address is a monitored Google Workspace
// group, so inbound mail is already filtered by Google. A form would move that
// traffic somewhere with worse spam handling and add a queue nobody watches.
// Revisit once EconRunes ships and enquiry volume justifies structured intake.
const contactEmail = "contact@goldsimulations.com";
---

<BaseLayout
  title="Contact"
  description="Get in touch with Gold Simulations about classroom pilots, institutional licensing, or anything else."
  navStyle="default"
>
  <section class="site-container pt-24 pb-8 md:pt-28">
    <div class="mx-auto max-w-3xl text-center">
      <h1 class="h1">Get in <ShineText>touch</ShineText></h1>
      <p class="description mt-4">
        We read everything that arrives and reply to real messages from real people.
      </p>
    </div>
  </section>

  <section class="site-container pb-20 md:pb-24">
    <div class="bg-card mx-auto max-w-xl rounded-2xl border p-6 text-center shadow-sm md:p-10">
      <h2 class="text-muted-foreground text-xs font-medium tracking-wide uppercase">Email us</h2>

      <a
        href={`mailto:${contactEmail}`}
        class="text-primary-accent hover:text-primary mt-3 inline-flex items-center gap-2 text-lg font-semibold break-all"
      >
        <Icon name="tabler/mail" class="size-5 shrink-0" aria-hidden="true" />
        {contactEmail}
      </a>

      <p class="text-muted-foreground mt-4 text-md">
        If that link doesn't open your mail app, copy the email address and paste it into your mail client.
      </p>

      <hr class="border-border my-8" />

      <p class="text-muted-foreground text-md">
        Stay informed about everything Gold Simulations, <a
          href="/subscribe/"
          class="text-primary hover:text-primary-accent underline">join the waitlist</a
        >.
      </p>

      <hr class="border-border my-8" />

      <h2 class="text-muted-foreground text-xs font-medium tracking-wide uppercase">Elsewhere</h2>
      <div class="mt-3 flex flex-wrap justify-center gap-4">
        {
          socialLinks.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-foreground/70 hover:text-primary-accent inline-flex items-center gap-2 text-sm"
            >
              <Icon name={s.icon} class="size-4" aria-hidden="true" />
              {s.label}
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
