---
import Button from "@/components/button/Button.astro";
import { getLocaleFromUrl } from "@/js/localeUtils";

import BaseLayout from "@/layouts/BaseLayout.astro";
import AccentBlur from "@/components/accent-blur/AccentBlur.astro";

const currLocale = getLocaleFromUrl(Astro.url);
---

<BaseLayout title="Coming Soon" description="This item is coming soon." noindex={true}>
  <section
    class="site-container flex min-h-[90vh] flex-col items-center justify-center py-24 text-center"
  >
    <h1 class="mb-4 text-6xl font-semibold">Coming Soon!</h1>
    <p class="mb-6 text-xl">This area is coming soon. Join the waitlist for launch updates.</p>
    <div
      class="mt-6 flex flex-wrap justify-center gap-4 md:justify-start"
      data-mos="fade-up"
      data-mos-delay=".2"
      data-mos-anchor="#hero-basic-cta"
    >
      <Button variant="primary" href={"/subscribe/"}>
        Subscribe
      </Button>
      <Button
        variant="secondary"
        arrow="right"
        href="/features/"
      >
        Features
      </Button>
      <Button
        variant="outline"
        arrow="right"
        href="/games/econrunes/"
      >
        Explore The Game
      </Button>
    </div>
    <AccentBlur color="blue" />
  </section>
</BaseLayout>
