---
import CategoryCloud from "@/components/category-cloud/CategoryCloud.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Categories"
  description="Browse news and articles by category."
>
  <section class="site-container py-24 md:pt-28">
    <div class="overflow-x-clip">
      <div class="mr-auto flex max-w-[950px] flex-col">
        <h1 class="h1">News Categories</h1>
        <p class="description mt-2">
          Browse our news and articles by category.
        </p>
      </div>

      <div class="mt-6 flex pb-16">
        <CategoryCloud />
      </div>
    </div>
  </section>
</BaseLayout>