---
import { Icon } from "astro-icon/components";

import Button from "@/components/button/Button.astro";
import { Alert, AlertDescription, AlertTitle } from "@/components/starwind/alert";
import { Input } from "@/components/starwind/input";
import { Label } from "@/components/starwind/label";
---

<form method="post" class="space-y-6" id="subscribe-form">
  <div class="space-y-2">
    <Label for="subscribe-email">Email</Label>
    <Input
      required
      name="email"
      type="email"
      id="subscribe-email"
      placeholder="you@school.edu"
      autocomplete="email"
    />
  </div>

  <Button type="submit" variant="primary" class="w-full" id="subscribe-button">
    <span id="subscribe-button-text">Subscribe</span>
    <span id="subscribe-button-spinner" hidden class="inline-flex items-center gap-2">
      <svg
        class="size-4 animate-spin"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"
        ></circle>
        <path
          class="opacity-75"
          fill="currentColor"
          d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
        ></path>
      </svg>
      Sending...
    </span>
  </Button>

  <Alert variant="error" id="subscribe-alert-error" hidden>
    <AlertTitle>Something went wrong</AlertTitle>
    <AlertDescription id="subscribe-error-message">Please try again later.</AlertDescription>
  </Alert>

  <Alert variant="success" id="subscribe-alert-pending" hidden>
    <AlertTitle>
      <Icon name="tabler/circle-check" class="mr-2 inline size-5" aria-hidden="true" />
      Check your inbox
    </AlertTitle>
    <AlertDescription>
      We've sent a confirmation link to your email. Click the link to finish subscribing.
    </AlertDescription>
  </Alert>

  <div id="subscribe-resend-container" hidden class="text-center text-sm text-foreground/70">
    <p class="mb-1">Didn't receive the email?</p>
    <button
      type="button"
      id="subscribe-resend-button"
      class="text-primary hover:text-primary-accent underline"
    >
      Resend confirmation
    </button>
  </div>
</form>

<script>
  import { actions } from "astro:actions";

  const form = document.getElementById("subscribe-form") as HTMLFormElement | null;
  const emailInput = document.getElementById("subscribe-email") as HTMLInputElement | null;
  const button = document.getElementById("subscribe-button") as HTMLButtonElement | null;
  const buttonText = document.getElementById("subscribe-button-text");
  const buttonSpinner = document.getElementById("subscribe-button-spinner");
  const alertError = document.getElementById("subscribe-alert-error");
  const alertPending = document.getElementById("subscribe-alert-pending");
  const errorMessage = document.getElementById("subscribe-error-message");
  const resendContainer = document.getElementById("subscribe-resend-container");
  const resendButton = document.getElementById("subscribe-resend-button") as HTMLButtonElement | null;

  let pendingEmail = "";

  function setLoading(loading: boolean) {
    if (!button) return;
    button.disabled = loading;
    if (loading) {
      buttonText?.setAttribute("hidden", "true");
      buttonSpinner?.removeAttribute("hidden");
    } else {
      buttonText?.removeAttribute("hidden");
      buttonSpinner?.setAttribute("hidden", "true");
    }
  }

  function showError(message: string) {
    if (errorMessage) errorMessage.textContent = message;
    alertError?.removeAttribute("hidden");
    alertPending?.setAttribute("hidden", "true");
    resendContainer?.setAttribute("hidden", "true");
  }

  function showPending() {
    alertPending?.removeAttribute("hidden");
    alertError?.setAttribute("hidden", "true");
    resendContainer?.removeAttribute("hidden");
    if (emailInput) emailInput.readOnly = true;
    button?.setAttribute("hidden", "true");
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    setLoading(true);

    const formData = new FormData(form);
    pendingEmail = (formData.get("email") as string) ?? "";

    const { error } = await actions.subscribe(formData);

    setLoading(false);

    if (error) {
      showError(error.message || "Please try again later.");
    } else {
      showPending();
    }
  });

  resendButton?.addEventListener("click", async () => {
    if (!pendingEmail || !resendButton) return;

    resendButton.disabled = true;
    const originalLabel = resendButton.textContent;
    resendButton.textContent = "Sending...";

    const formData = new FormData();
    formData.append("email", pendingEmail);

    const { error } = await actions.resendConfirmation(formData);

    if (error) {
      showError(error.message || "Failed to resend. Please try again.");
      resendButton.disabled = false;
      resendButton.textContent = originalLabel ?? "Resend confirmation";
    } else {
      resendButton.textContent = "Sent!";
      resendButton.classList.remove("underline");
      resendButton.classList.add("text-foreground/50");
    }
  });
</script>
