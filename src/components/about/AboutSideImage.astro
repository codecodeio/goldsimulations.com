---
import Button from "@/components/button/Button.astro";
import Badge from "@/components/starwind/badge/Badge.astro";
import CourseFitGrid from "@/components/feature/CourseFitGrid.astro";
import ShineText from "@/components/shine-text/ShineText.astro";
import { getLocaleFromUrl } from "@/js/localeUtils";
import AccentBlur from "../accent-blur/AccentBlur.astro";
const currLocale = getLocaleFromUrl(Astro.url);
interface Props {
  class?: string;
}

const { class: className } = Astro.props as Props;
---

<section class:list={["relative overflow-clip pt-24 pb-16 md:pt-28 md:pb-24", className]}>
  <div class="site-container relative z-10 grid gap-8 md:grid-cols-2 md:gap-16">
    <div class="text-center md:text-left" id="about-side-image-trigger">
      <h1 data-mos="fade-up" class="h1">Interactive Economics Simulations for <ShineText>Modern Classrooms</ShineText> </h1>

      <div class="text-muted-foreground mt-6">
        <p
          class="md:text-lg"
          data-mos="fade-up"
          data-mos-anchor="#about-side-image-trigger"
          data-mos-delay=".2"
        >
          EconRunes is designed to transform the way economics is taught and learned. By integrating interactive simulations into the curriculum, EconRunes allows students to actively engage with economic concepts, making learning more dynamic and effective. 
        </p>

        <p
          class="mt-6 md:text-lg"
          data-mos="fade-up"
          data-mos-anchor="#about-side-image-trigger"
          data-mos-delay=".4"
        >
          Our simulations are meticulously crafted based on educational research to ensure they meet the needs of modern classrooms.
        </p>

        <p
          class="mt-6 md:text-lg"
          data-mos="fade-up"
          data-mos-anchor="#about-side-image-trigger"
          data-mos-delay=".6"
        >
          Turn economic concepts into hands-on learning with immersive digital simulations built for colleges, MBA programs, and high schools.
        </p>
      </div>
      <div class="flex justify-center pt-8 md:justify-start" data-mos="fade-up"
          data-mos-delay=".6"
          data-mos-anchor="#hero-side-coming-soon">
        <Badge variant="warning">Coming soon</Badge>
        </div>
        
        <div
          class="mt-6 flex flex-wrap justify-center gap-4 md:justify-start"
          data-mos="fade-up"
          data-mos-delay=".6"
          data-mos-anchor="#hero-side-cta"
        >
          <Button variant="primary" href={"/subscribe/"}>
            Get Started
          </Button>

          <Button variant="secondary" arrow="right" href={"/resources/syllabus/"}>
            Resources
          </Button>
          
          <Button
            variant="outline"
            arrow="right"
            href="/games/econrunes/"  
          >
            Explore The Game
          </Button>
        </div>
    </div>

    <div class="flex items-center">
      <CourseFitGrid />
    </div>
  </div>
  <AccentBlur color="blue"/>
</section>