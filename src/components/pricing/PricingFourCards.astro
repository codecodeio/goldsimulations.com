---
/**
 * Pricing section with 4 tiers and a per-student / per-class-section toggle.
 * Personal-use tiers (Free, Adventurer) display static prices unaffected by the toggle.
 */

import { Icon } from "astro-icon/components";

import Button from "@/components/button/Button.astro";
import ShineText from "@/components/shine-text/ShineText.astro";
import { Switch } from "@/components/starwind/switch";
import { getLocaleFromUrl } from "@/js/localeUtils";
interface featureItem {
  name: string;
  comingSoon?: boolean;
}

interface pricingItem {
  name: string; // plan name
  description: string; // plan description
  personalUse?: boolean; // if true, price doesn't change with toggle
  note?: string; // optional note displayed below the price
  price: {
    custom?: boolean; // if true, will show "contact us" instead of price
    monthly?: number; // per student price (or static price for personal use)
    yearly?: number; // per class section price
  };
  priceLabel?: string; // label shown below price for personal use tiers
  features: (string | featureItem)[]; // strings for built features; objects to mark "coming soon"
  href: string; // button link to sign up or other page
  linkText: string; // text for the button
}

const pricingData: pricingItem[] = [
  {
    name: "Free",
    description:
      "Start your journey with EconRunes Realm 1. Explore core economic concepts at your own pace.",
    personalUse: true,
    priceLabel: "(personal use)",
    price: {
      monthly: 0,
    },
    features: [
      "EconRunes Realm 1",
      "Solo play",
      "Basic tutorials",
    ],
    href: "/sign-up",
    linkText: "Get Started",
  },
  {
    name: "Adventurer",
    description:
      "Unlock all Realms and master the full EconRunes experience. Perfect for curious minds and self-learners.",
    personalUse: true,
    priceLabel: "(one-time purchase)",
    note: "Personal use only — classroom features not included",
    price: {
      monthly: 19,
    },
    features: [
      "All EconRunes Realms (as released)",
      { name: "Multiplayer with friends", comingSoon: true },
      { name: "Leaderboards & achievements", comingSoon: true },
      "Progress tracking",
      "Priority support",
    ],
    href: "/sign-up",
    linkText: "Buy Now",
  },
  {
    name: "High Schools",
    description:
      "Bring economics to life in your classroom. Affordable, curriculum-aligned simulations for high school educators.",
    price: {
      monthly: 8,
      yearly: 149,
    },
    features: [
      "All EconRunes Realms",
      { name: "Classroom management dashboard", comingSoon: true },
      { name: "Student progress reports", comingSoon: true },
      { name: "Class assignments & scenarios", comingSoon: true },
      "Up to 35 students per section",
      "Teacher resources & guides",
      "Email support",
    ],
    href: "/sign-up",
    linkText: "Start Free Trial",
  },
  {
    name: "Colleges",
    description:
      "Advanced economic simulations for higher education. Research-grade tools for rigorous academic environments.",
    price: {
      monthly: 15,
      yearly: 299,
    },
    features: [
      "All EconRunes Realms",
      { name: "Classroom management dashboard", comingSoon: true },
      { name: "Student progress reports", comingSoon: true },
      { name: "Class assignments & scenarios", comingSoon: true },
      { name: "Data export for research", comingSoon: true },
      { name: "Custom scenario builder", comingSoon: true },
      { name: "LMS integration (Canvas, Blackboard)", comingSoon: true },
      "Unlimited students per section",
      "Email support",
      "Onboarding assistance",
    ],
    href: "/sign-up",
    linkText: "Start Free Trial",
  },
];

const currLocale = getLocaleFromUrl(Astro.url);
---

<section id="pricing-four-cards" class="pt-24 pb-20 md:pt-28 md:pb-24">
  <div class="site-container relative">
    <div class="flex justify-center">
      <!-- <Badge>Pricing</Badge> -->
    </div>
    <div class="flex justify-center">
      <h1 class="h1 inline text-center"><ShineText>Choose</ShineText> Your Economics Adventure</h1>
    </div>

    <!-- Toggle switch for monthly or yearly pricing -->
    <div class="mt-6 flex justify-center">
      <label
        for="pricing-four-cards__toggle"
        class="relative inline-flex cursor-pointer items-center gap-4 select-none"
      >
        <span class="description flex items-center">Per Student</span>
        <Switch id="pricing-four-cards__toggle" variant="primary" padding={4} />
        <span class="description flex items-center">Per Class Section</span>
      </label>
    </div>

    <!-- works for 3 pricing plans, adjust grid cols here to support more or less -->
    <div class="mx-auto mt-16 grid w-full gap-6 sm:grid-cols-2 md:mt-20 lg:grid-cols-4">
      {
        pricingData.map((plan) => (
          <div class="pricing-plan w-full">
            <div
              class="bg-muted relative flex h-full flex-col justify-between rounded-xl border p-8 text-center shadow-sm"
            >
              <div>
                <h3 class="text-muted-foreground mb-8 text-lg font-medium">
                  {plan.name}
                </h3>
                <div class="min-h-[6.5rem] flex flex-col items-center justify-center">
                  {plan.price.custom === true ? (
                    <>
                      <h4>
                        <span class="text-4xl font-medium">Custom</span>
                      </h4>
                      <span aria-hidden="true" class="text-muted-foreground invisible inline-block">
                        per student
                      </span>
                    </>
                  ) : plan.personalUse === true ? (
                    <>
                      <h4 class="text-4xl font-medium">
                        {plan.price.monthly === 0 ? "Free" : `$${plan.price.monthly}`}
                      </h4>
                      <span class="text-muted-foreground inline-block text-sm">
                        {plan.priceLabel}
                      </span>
                      {plan.note && (
                        <p class="text-muted-foreground mt-1 text-xs">{plan.note}</p>
                      )}
                    </>
                  ) : (
                    <>
                      <div class="pricing-monthly">
                        <h4 class="text-4xl font-medium">${plan.price.monthly}</h4>
                        <span class="text-muted-foreground inline-block text-sm">(per student)</span>
                      </div>
                      <div class="pricing-yearly hidden">
                        <h4 class="text-4xl font-medium">${plan.price.yearly}</h4>
                        <span class="text-muted-foreground inline-block text-sm">(per class section)</span>
                      </div>
                    </>
                  )}
                </div>

                <div class="mt-8 border-y py-8">
                  <p class="text-muted-foreground mx-auto max-w-xs">
                    {plan.description}
                  </p>
                </div>
                <ul class="py-8">
                  {plan.features.map((feature) => {
                    const isString = typeof feature === "string";
                    const name = isString ? feature : feature.name;
                    const comingSoon = !isString && feature.comingSoon === true;
                    return (
                      <li class="mb-2.5 flex items-start gap-3">
                        <Icon
                          name="tabler/check"
                          class:list={[
                            "mt-0.5 size-5 shrink-0",
                            comingSoon ? "text-muted-foreground/40" : "text-primary-accent",
                          ]}
                          aria-hidden="true"
                        />
                        <span class="text-muted-foreground text-left font-medium">
                          {name}
                          {comingSoon && (
                            <span class="ml-1 text-xs italic opacity-70">(coming soon)</span>
                          )}
                        </span>
                      </li>
                    );
                  })}
                </ul>
              </div>
              <Button
                class="mb-0 w-full"
                variant="outline"
                href={plan.href}
              >
                {plan.linkText}
              </Button>
            </div>
          </div>
        ))
      }
    </div>
    <p class="text-muted-foreground mx-auto mt-10 max-w-2xl text-center text-sm">
      <strong>Per Class Section</strong> pricing covers one instructor's class of up to 35 students
      for a single course enrollment. Need to cover multiple sections or an entire department?
      <a href="/contact" class="text-primary-accent underline">Contact us</a> for volume discounts.
    </p>
  </div>
</section>

<script>
  import type { SwitchChangeEvent } from "@/components/starwind/switch";

  function pricingPlanToggleSetup() {
    const pricingSection = document.getElementById("pricing-four-cards");
    const toggle = pricingSection?.querySelector("#pricing-four-cards__toggle");
    const monthlyPrices = pricingSection?.querySelectorAll(".pricing-monthly");
    const yearlyPrices = pricingSection?.querySelectorAll(".pricing-yearly");

    if (!toggle || !monthlyPrices || !yearlyPrices) return;

    toggle.addEventListener("starwind-switch:change", (e: Event) => {
      const event = e as SwitchChangeEvent;
      const isYearly = event.detail.checked;

      monthlyPrices.forEach((price) => price.classList.toggle("hidden", isYearly));
      yearlyPrices.forEach((price) => price.classList.toggle("hidden", !isYearly));
    });
  }

  // runs on initial page load
  pricingPlanToggleSetup();

  // runs on view transitions navigation
  document.addEventListener("astro:after-swap", pricingPlanToggleSetup);
</script>