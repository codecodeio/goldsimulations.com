---
/**
 * * Testimonials section marquee
 * JS allows the animation to pause while you hover over it
 * Adjust the speed of the marquee by changing the "marquee" animation duration in the tailwind.config.cjs file
 */

import Badge from "@/components/badge/Badge.astro";
import { getLocaleFromUrl } from "@/js/localeUtils";
import { getTranslatedData } from "@/js/translationUtils";

import TestimonialCard from "./TestimonialItemCard.astro";

const currLocale = getLocaleFromUrl(Astro.url);
const testimonialData = getTranslatedData("testimonialData", currLocale);
---

<section
  id="testimonials-marquee-section"
  class="mx-auto max-w-[2000px] overflow-x-hidden px-4 pb-20 md:pb-24"
>
  <div class="mb-10 flex flex-col justify-center text-center">
    <Badge>Testimonials</Badge>
    <h2 class="h2 mt-4">Hear from our customers</h2>
  </div>

  <div class="relative -mt-2">
    <!-- left fade-out (desktop only) -->
    <div
      class="from-background pointer-events-none absolute top-0 -left-px z-20 hidden h-full w-[10%] bg-gradient-to-r from-10% to-transparent md:block"
    >
    </div>
    <!-- right fade-out (desktop only) -->
    <div
      class="to-background pointer-events-none absolute top-0 -right-px z-20 hidden h-full w-[10%] bg-gradient-to-r from-transparent to-90% md:block"
    >
    </div>

    <div
      class="testimonials-scroll relative h-full snap-x snap-mandatory overflow-x-auto py-4 [scrollbar-width:none] md:snap-none md:overflow-x-hidden [&::-webkit-scrollbar]:hidden"
    >
      <div class="testimonial-marquee flex gap-6">
        <div
          class="flex shrink-0 items-start gap-6 md:min-w-full md:justify-around testimonial-row md:animate-marquee-testimonials"
        >
          {
            testimonialData.map((testimonial, idx) => (
              <div class="w-[clamp(17rem,40vw,23rem)] shrink-0 snap-center">
                <TestimonialCard {...testimonial} />
              </div>
            ))
          }
        </div>
        <div
          aria-hidden="true"
          class="hidden min-w-full shrink-0 items-start justify-around gap-6 md:flex testimonial-row md:animate-marquee-testimonials"
        >
          {
            testimonialData.map((testimonial, idx) => (
              <div class="w-[clamp(17rem,40vw,23rem)]">
                <TestimonialCard {...testimonial} />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const setupTestimonialMarquee = () => {
    const testimonialMarquee = document.querySelector(".testimonial-marquee");

    // add the clauss "pause" when the mouse enters the marquee
    testimonialMarquee?.addEventListener("mouseover", () => {
      testimonialMarquee.querySelectorAll(".testimonial-row").forEach((el) => {
        el.classList.add("pause");
      });
    });

    // remove the class "pause" when the mouse leaves the marquee
    testimonialMarquee?.addEventListener("mouseout", () => {
      testimonialMarquee.querySelectorAll(".testimonial-row").forEach((el) => {
        el.classList.remove("pause");
      });
    });
  };

  // runs on initial page load
  setupTestimonialMarquee();

  // runs on view transitions navigation
  document.addEventListener("astro:after-swap", setupTestimonialMarquee);
</script>