---
import AccentBlur from "@/components/accent-blur/AccentBlur.astro";
import Badge from "@/components/badge/Badge.astro";
import Button from "@/components/button/Button.astro";
---

<section id="roadmap" class="relative overflow-clip pb-20 md:pb-24">
  <div class="site-container relative z-10">
    <div class="mx-auto max-w-2xl text-center" data-mos="fade-up">
      <Badge>Roadmap</Badge>
      <h2 class="h2 mt-4 mb-4">What's <span class="text-primary-accent">next</span></h2>
      <p class="description mb-8 text-pretty">
        Beta opens with all five realms of Level 1. From there the journey deepens — Level 2
        challenges, a classroom dashboard with graded assignments, leaderboards, multiplayer,
        and LMS integration are all on the way.
      </p>
      <div class="flex justify-center">
        <Button variant="primary" href="/games/econrunes/#roadmap" arrow="right">
          See the full roadmap
        </Button>
      </div>
    </div>
  </div>
  <AccentBlur color="blue" />
</section>
