---
/**
 * "The Challenge in Today's Economics Classroom" section for /features.
 * Mirrors the FeatureCardSideImage layout (text on right, media on left)
 * but uses the interactive DriftingEquations SVG instead of an image.
 */
import DriftingEquations from "@/components/chart/DriftingEquations.astro";
---

<section class="overflow-hidden pb-20 md:pb-24">
  <div class="site-container">
    <div
      class="mx-auto grid scroll-mt-24 gap-8 rounded-lg md:grid-cols-2 md:gap-12 md:rounded-xl lg:gap-16"
      data-mos="fade-right"
    >
      <!-- Media (left on md+, below text on mobile) -->
      <div class="order-2 mb-auto h-auto w-full overflow-hidden rounded-xl border md:order-1">
        <DriftingEquations />
      </div>

      <!-- Text (right on md+, above media on mobile) -->
      <div class="order-1 col-span-1 flex items-center md:order-2">
        <div class="md:py-6">
          <h2 class="h2 mt-4">The Challenge in Today's Economics Classroom</h2>
          <p class="text-muted-foreground mt-4 mr-auto max-w-xl text-pretty">
            Students struggle with abstract theory which often fails to engage students,
            leading to lower retention and understanding of key economic concepts.
            Memorization without intuition, low engagement levels, and difficulty applying
            theory to real-world scenarios are common issues. Instructors struggle with
            keeping students engaged, demonstrating practical applications of economic
            theories, and providing interactive learning experiences.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
