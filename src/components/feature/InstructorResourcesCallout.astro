---
/**
 * "For Instructors" callout linking to syllabus + learning objectives.
 * Used on pages where instructors evaluating EconRunes need course-planning resources.
 */
import { Icon } from "astro-icon/components";

import Button from "@/components/button/Button.astro";
---

<section id="instructor-resources" class="site-container py-12 md:py-16">
  <div
    class="border-gray/45 bg-base-100/40 dark:bg-base-800/30 mx-auto flex max-w-3xl flex-col items-center gap-6 rounded-2xl border-2 p-8 text-center md:p-10"
    data-mos="fade-up"
  >
    <Icon name="tabler/presentation" class="text-primary-accent size-10" aria-hidden="true" />
    <div>
      <h2 class="h3 mb-2">For Instructors</h2>
      <p class="description text-pretty">
        Planning your semester? See the syllabus and learning objectives to gauge how
        EconRunes fits your course.
      </p>
    </div>
    <div class="flex flex-wrap justify-center gap-3">
      <Button variant="secondary" arrow="right" href="/resources/syllabus/">
        Syllabus
      </Button>
      <Button variant="outline" arrow="right" href="/resources/learning-objectives/">
        Learning Objectives
      </Button>
    </div>
  </div>
</section>
