---
/**
 * * Hero with image one the side
 */

import { Icon } from "astro-icon/components";

import AccentBlur from "@/components/accent-blur/AccentBlur.astro";
import Button from "@/components/button/Button.astro";
import GamesGrid from "@/components/hero/GamesGrid.astro";
import ShineText from "@/components/shine-text/ShineText.astro";
---

<!-- "dark" class forces dark mode for this section -->
<section id="hero-side" class="relative overflow-clip pt-24 md:pt-28">
  <div class="site-container relative z-10 pb-16 md:pb-20">
    <div
      class="mx-auto grid max-w-md gap-10 text-center md:max-w-none md:grid-cols-2 md:text-left xl:items-center"
    >
      <div class="mx-auto my-auto w-full pt-4 md:ml-0 md:max-w-[560px] md:pb-10 lg:pr-10">
        <div class="" data-mos="fade-up" data-mos-anchor="#hero-side">
          <h1 class="h1 mb-6">
            Where Economics Classrooms <ShineText>Come to Life</ShineText>
          </h1>
        </div>
        <p
          class="description mb-8 text-pretty lg:text-lg"
          data-mos="fade-up"
          data-mos-delay=".1"
          data-mos-anchor="#hero-side-overview"
        >
          Our immersive games change how students learn economics. Abstract concepts become hands-on decisions. Learners explore, experiment, and truly understand how markets work by applying theory and living with the outcomes. Designed for colleges, MBA programs, and high schools. Explore our flagship game, EconRunes.
        </p>
        <div
          class="text-muted-foreground flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm md:justify-start"
          data-mos="fade-up"
          data-mos-delay=".2"
          data-mos-anchor="#hero-side-trust"
        >
          <span class="inline-flex items-center gap-1.5">
            <Icon
              name="tabler/circle-check"
              class="size-4 text-brand-green"
              aria-hidden="true"
            />
            Built by economists
          </span>
          <span class="inline-flex items-center gap-1.5">
            <Icon
              name="tabler/devices"
              class="size-4 text-brand-green"
              aria-hidden="true"
            />
            Works on any device
          </span>
        </div>

        <div
          class="mt-6 flex flex-wrap justify-center gap-4 md:justify-start"
          data-mos="fade-up"
          data-mos-delay=".3"
          data-mos-anchor="#hero-side-cta"
        >
          <Button variant="primary" arrow="right" href="/subscribe/">
            Join the Waitlist
          </Button>

          <Button variant="secondary" arrow="right" href="/features/">
            How It Works
          </Button>
        </div>
      </div>

      <div
        class="flex h-full w-full flex-grow items-center"
        data-mos="fade-in"
        data-mos-anchor="#hero-side"
        data-mos-delay=".5"
      >
        <GamesGrid />
      </div>
    </div>
  </div>

  <AccentBlur color="blue" />
</section>