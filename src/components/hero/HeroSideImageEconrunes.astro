---
/**
 * * Hero with image one the side
 */

import Badge from "@/components/starwind/badge/Badge.astro";
import Button from "@/components/button/Button.astro";
import ChartEconrunes from "@/components/chart/ChartEconrunes.astro";
import { getLocaleFromUrl } from "@/js/localeUtils";
const currLocale = getLocaleFromUrl(Astro.url);
---

<!-- "dark" class forces dark mode for this section -->
<section id="hero-side" class="mt-16 overflow-x-clip">
  <div class="site-container py-16 md:py-20">
    <div
      class="mx-auto grid max-w-md gap-10 text-center md:max-w-none md:grid-cols-2 md:text-left xl:items-center"
    >
      <div class="mx-auto my-auto w-full pt-4 md:ml-0 md:max-w-[560px] md:py-10 lg:pr-10">
        <div class="" data-mos="fade-up" data-mos-anchor="#hero-side">
          <h1
            class="mb-6 text-5xl leading-tight font-medium tracking-tight text-pretty md:text-5xl md:leading-tight"
          >
            EconRunes: An <br><span class="text-primary-accent">Epic Quest </span> through Microeconomic Realms
          </h1>
        </div>
        <p
          class="description mb-8 text-pretty lg:text-lg"
          data-mos="fade-up"
          data-mos-delay=".1"
          data-mos-anchor="#hero-side"
        >
          EconRunes turns four microeconomic market structures into playable realms. Students make decisions such as pricing or production round by round, see cost and demand curves update live, and earn a Rune for mastering each market. Launches with all five realms, including a capstone called the Council of Runes.
        </p>
        <div data-mos="fade-up"
          data-mos-delay=".2"
          data-mos-anchor="#hero-side-coming-soon">
        <Badge variant="warning">Coming soon</Badge>
        </div>
        <div
          class="mt-6 flex flex-wrap justify-center gap-4 md:justify-start"
          data-mos="fade-up"
          data-mos-delay=".2"
          data-mos-anchor="#hero-side"
        >
          <Button variant="primary" href="/subscribe/">
            Join the Waitlist
          </Button>
          <Button
            variant="ghost"
            arrow="right"
            href="#story"
          >
            Learn the Story
          </Button>
          <Button
            variant="ghost"
            arrow="right"
            href="#feature-side-image"
          >
            Learn About Each Realm
          </Button>
        </div>
      </div>

      <div
        class="flex h-full w-full flex-grow items-center"
        data-mos="fade-in"
        data-mos-anchor="#hero-side"
      >
        <div class="relative w-full overflow-hidden rounded-xl border">
          <ChartEconrunes />
        </div>
      </div>
    </div>
  </div>
</section>