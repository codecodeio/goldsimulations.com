---
import Button from "@/components/button/Button.astro";
import { getLocaleFromUrl } from "@/js/localeUtils";
import { getTranslatedData, useTranslations } from "@/js/translationUtils";

const currLocale = getLocaleFromUrl(Astro.url);
const siteData = getTranslatedData("siteData", currLocale);
---

<section
  class="site-container flex min-h-[40lvh] flex-col items-center justify-center pb-20 text-center md:pb-24"
>
  <h1 class="h1" data-mos="fade-up">
    Bring Interactive Learning to Your Classroom
  </h1>
  <p class="text-muted-foreground mx-auto mt-6 max-w-xl" data-mos="fade-up" data-mos-delay=".2">
    {siteData.title}
  </p>
  <div
    class="mt-6 flex flex-wrap justify-center gap-4 md:justify-start"
    data-mos="fade-up"
    data-mos-delay=".4"
    data-mos-anchor="#hero-basic-cta"
  >
    <Button variant="primary" href="/subscribe/">
      Join the Waitlist
    </Button>
    <Button
      variant="secondary"
      href="/features/"  
    >
      How it Works
    </Button>
    <Button
      variant="outline"
      arrow="right"
      href="/games/econrunes/"  
    >
      Explore EconRunes
    </Button>
  </div>
</section>